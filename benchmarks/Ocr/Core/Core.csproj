<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Target.local.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Qcxt.OCR</AssemblyName>
    <RootNamespace>Qcxt.OCR</RootNamespace>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Qcxt.OCR" />
    <Compile Include="$(QcxtRoot)/src/Qcxt.OCR/**/*.cs" Exclude="$(QcxtRoot)/src/Qcxt.OCR/**/obj/**;$(QcxtRoot)/src/Qcxt.OCR/**/bin/**" LinkBase="Qcxt.OCR" />
    <EmbeddedResource Include="$(QcxtRoot)/src/Qcxt.OCR/Models/ChineseV6Tiny/Resources/det.onnx" LogicalName="Qcxt.OCR.Models.ChineseV6Tiny.det.onnx" />
    <EmbeddedResource Include="$(QcxtRoot)/src/Qcxt.OCR/Models/ChineseV6Tiny/Resources/rec.onnx" LogicalName="Qcxt.OCR.Models.ChineseV6Tiny.rec.onnx" />
    <EmbeddedResource Include="$(QcxtRoot)/src/Qcxt.OCR/Models/ChineseV6Tiny/Resources/dict.txt" LogicalName="Qcxt.OCR.Models.ChineseV6Tiny.dict.txt" />
    <EmbeddedResource Include="$(QcxtRoot)/src/Qcxt.OCR/Models/TextLineOrientation/Resources/cls.onnx" LogicalName="Qcxt.OCR.Models.TextLineOrientation.cls.onnx" />
    <EmbeddedResource Include="$(QcxtRoot)/src/Qcxt.OCR/Backends/Vulkan/Shaders/*.spv" LogicalName="Qcxt.OCR.Backends.Vulkan.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(QcxtRoot)/src/Qcxt.OCR/Backends/Metal/Shaders/*.metal" LogicalName="Qcxt.OCR.Backends.Metal.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>