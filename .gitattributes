* text=auto
*.sln text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
# Matplotlib wraps SVG path data with insignificant trailing spaces.
*.svg text eol=lf whitespace=-blank-at-eol
*.spv binary
*.zlib binary
*.pdf binary
*.gif binary
# Preserve upstream notices and unified-diff evidence verbatim.
docs/licenses/PdfPig-UPSTREAM-NOTICES.txt text eol=lf whitespace=-blank-at-eol
docs/licenses/SkiaSharp-MIT.txt text eol=lf whitespace=-blank-at-eol
docs/evidence/velashell-2026-10-27/*.patch -text whitespace=-blank-at-eol
# These evidence files carry byte-level hashes; preserve measured file bytes.
docs/evidence/skia-comparison-2026-11-01/* -text whitespace=cr-at-eol
docs/evidence/api-final-2026-11-07/** -text whitespace=cr-at-eol
docs/evidence/api-final-package-consumption-2026-11-07/** -text whitespace=cr-at-eol
docs/evidence/api-final-ci-recheck-2026-11-07/** -text whitespace=cr-at-eol
