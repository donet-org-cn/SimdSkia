<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <Description>SimdSkia convenience package for the documented SkiaSharp namespace source compatibility subset. Different assembly identity; incomplete APIs; no binary replacement guarantee. For Avalonia use SimdSkia.Avalonia.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SimdSkia.Compatibility/SimdSkia.Compatibility.csproj" />
    <None Include="_._" Pack="true" PackagePath="lib/$(TargetFramework)/_._" />
  </ItemGroup>
</Project>
