<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0-preview.4</Version>
    <Authors>hnlyf168</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hnlyf168/SimdSkia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hnlyf168/SimdSkia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Experimental managed C# 2D rendering components. Preview only; API and rendering compatibility are incomplete. No Google Skia rendering dependency.</Description>
    <PackageTags>SimdSkia;graphics;rendering;managed;preview</PackageTags>
    <PackageReleaseNotes>Preview 4: measured CPU span/gradient/image optimizations; bounded exact-content GPU texture reuse with lower allocations and memory; corrected high-DPI ImageBrush seams and area coverage (38/40 pinned probes); Direct2D opaque image alpha fix. Windows/Linux X11/macOS desktop hosts; optional Direct2D/Vulkan drawing. Full API, text/curve quality and macOS GPU remain incomplete.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../docs/NUGET-README.md" Pack="true" PackagePath="/README.md" Condition="'$(MSBuildProjectName)' != 'SimdSkia.Avalonia' AND '$(MSBuildProjectName)' != 'SimdSkia.Avalonia.Desktop' AND '$(MSBuildProjectName)' != 'SimdSkia.Avalonia.Gpu'" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
