<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0-preview.1</Version>
    <Authors>hnlyf168</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hnlyf168/SimdSkia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hnlyf168/SimdSkia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Experimental managed C# 2D rendering components. Preview only; API and rendering compatibility are incomplete. No Google Skia rendering dependency.</Description>
    <PackageTags>SimdSkia;graphics;rendering;managed;preview</PackageTags>
    <PackageReleaseNotes>First preview: CPU rendering, managed TrueType and imaging, optional Vulkan offscreen and Avalonia 12.1.4 adapter. Full compatibility and pixel equivalence are not guaranteed.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../docs/NUGET-README.md" Pack="true" PackagePath="/README.md" Condition="'$(MSBuildProjectName)' != 'SimdSkia.Avalonia'" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
