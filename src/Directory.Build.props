<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0-preview.2</Version>
    <Authors>hnlyf168</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hnlyf168/SimdSkia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hnlyf168/SimdSkia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Experimental managed C# 2D rendering components. Preview only; API and rendering compatibility are incomplete. No Google Skia rendering dependency.</Description>
    <PackageTags>SimdSkia;graphics;rendering;managed;preview</PackageTags>
    <PackageReleaseNotes>Preview 2: Windows/Linux X11/macOS desktop hosts, managed installed-font discovery, optional Avalonia Direct2D native swapchain and Vulkan framebuffer drawing. Managed glyph atlas, ROI uploads and explicit fallback diagnostics. macOS GPU/Metal is not implemented. Full compatibility is incomplete.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../docs/NUGET-README.md" Pack="true" PackagePath="/README.md" Condition="'$(MSBuildProjectName)' != 'SimdSkia.Avalonia' AND '$(MSBuildProjectName)' != 'SimdSkia.Avalonia.Desktop' AND '$(MSBuildProjectName)' != 'SimdSkia.Avalonia.Gpu'" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
