<Project>
  <!-- Prefer the host built against the resolved core assembly. Applications
       on a newer Avalonia version can start with the latest bundled host. -->
  <Target Name="SelectSimdSkiaAvaloniaHost" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="ResolvePackageAssets;ResolveLockFileReferences">
    <ItemGroup>
      <_SimdSkiaAvaloniaContract Include="@(Reference)" Condition="'%(Reference.Filename)' == 'Avalonia.Base' And Exists('%(Reference.Identity)')" />
      <_SimdSkiaAvaloniaContract Include="@(ResolvedCompileFileDefinitions)" Condition="'%(ResolvedCompileFileDefinitions.Filename)' == 'Avalonia.Base'" />
    </ItemGroup>
    <Error Condition="'@(_SimdSkiaAvaloniaContract)' == ''" Text="SimdSkia cannot locate the resolved Avalonia.Base assembly to select its matching window host." />
    <GetAssemblyIdentity AssemblyFiles="@(_SimdSkiaAvaloniaContract)">
      <Output TaskParameter="Assemblies" ItemName="_SimdSkiaAvaloniaIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_SimdSkiaResolvedAvaloniaVersion>@(_SimdSkiaAvaloniaIdentity->'%(Version)'->Distinct())</_SimdSkiaResolvedAvaloniaVersion>
      <_SimdSkiaHostVersion>$(_SimdSkiaResolvedAvaloniaVersion)</_SimdSkiaHostVersion>
      <_SimdSkiaResolvedPackageVersion>$([System.Version]::Parse('$(_SimdSkiaResolvedAvaloniaVersion)').ToString(3))</_SimdSkiaResolvedPackageVersion>
      <_SimdSkiaFallbackHostVersion>12.1.6.0</_SimdSkiaFallbackHostVersion>
      <_SimdSkiaFallbackHostVersion Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(_SimdSkiaResolvedAvaloniaVersion)', '12.2.0'))">12.2.0.0</_SimdSkiaFallbackHostVersion>
      <_SimdSkiaHostVersion Condition="'$(SimdSkiaSourceHosts)' != 'true' And !Exists('$(MSBuildThisFileDirectory)../hosts/$(_SimdSkiaHostVersion)/Avalonia.Win32.dll')">$(_SimdSkiaFallbackHostVersion)</_SimdSkiaHostVersion>
      <_SimdSkiaHostVersion Condition="'$(SimdSkiaSourceHosts)' == 'true' And !Exists('$(NuGetPackageRoot)/avalonia.win32/$(_SimdSkiaResolvedPackageVersion)/lib/net8.0/Avalonia.Win32.dll')">$(_SimdSkiaFallbackHostVersion)</_SimdSkiaHostVersion>
      <_SimdSkiaHostFolder>$(MSBuildThisFileDirectory)../hosts/$(_SimdSkiaHostVersion)/</_SimdSkiaHostFolder>
      <_SimdSkiaHostPackageVersion>$([System.Version]::Parse('$(_SimdSkiaHostVersion)').ToString(3))</_SimdSkiaHostPackageVersion>
    </PropertyGroup>
    <ItemGroup Condition="'$(SimdSkiaSourceHosts)' != 'true'">
      <_SimdSkiaHost Include="$(_SimdSkiaHostFolder)*.dll" />
    </ItemGroup>
    <ItemGroup Condition="'$(SimdSkiaSourceHosts)' == 'true'">
      <_SimdSkiaHost Include="$(NuGetPackageRoot)/avalonia.win32/$(_SimdSkiaHostPackageVersion)/lib/net8.0/*.dll;$(NuGetPackageRoot)/avalonia.x11/$(_SimdSkiaHostPackageVersion)/lib/net8.0/Avalonia.X11.dll;$(NuGetPackageRoot)/avalonia.freedesktop/$(_SimdSkiaHostPackageVersion)/lib/net8.0/*.dll;$(NuGetPackageRoot)/avalonia.freedesktop.atspi/$(_SimdSkiaHostPackageVersion)/lib/net8.0/*.dll;$(NuGetPackageRoot)/avalonia.native/$(_SimdSkiaHostPackageVersion)/lib/net8.0/*.dll" />
    </ItemGroup>
    <Error Condition="'@(_SimdSkiaHost)' == ''" Text="SimdSkia could not find the selected desktop host files ($(_SimdSkiaHostVersion)) for Avalonia $(_SimdSkiaResolvedAvaloniaVersion)." />
    <ItemGroup>
      <Reference Include="@(_SimdSkiaHost)" Private="true" />
    </ItemGroup>
    <PropertyGroup>
      <_SimdSkiaMacBridge>$(_SimdSkiaHostFolder)native/libAvaloniaNative.dylib</_SimdSkiaMacBridge>
      <_SimdSkiaMacBridge Condition="'$(SimdSkiaSourceHosts)' == 'true'">$(NuGetPackageRoot)/avalonia.native/$(_SimdSkiaHostPackageVersion)/runtimes/osx/native/libAvaloniaNative.dylib</_SimdSkiaMacBridge>
    </PropertyGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))">
      <Content Include="$(_SimdSkiaMacBridge)" Link="libAvaloniaNative.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Message Importance="High" Text="SimdSkia: Avalonia $(_SimdSkiaResolvedAvaloniaVersion) using Win32/X11/macOS hosts $(_SimdSkiaHostVersion)." />
  </Target>
</Project>
