<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Description>Preview Windows, Linux X11 and macOS software window hosts for SimdSkia. macOS uses the official MIT Avalonia native window bridge; drawing and fonts remain managed.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SimdSkia.Avalonia/SimdSkia.Avalonia.csproj" />
    <PackageReference Include="Avalonia" Version="[12.1.4]" GeneratePathProperty="true" ExcludeAssets="compile" />
    <Reference Include="$(PkgAvalonia)/lib/net8.0/*.dll" />
    <PackageReference Include="Avalonia.FreeDesktop" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.FreeDesktop.AtSpi" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.Native" Version="[12.1.4]" />
    <!-- The X11 package declares an unused Skia dependency. Consume its managed
         assembly directly; do not bring the original rendering implementation. -->
    <PackageDownload Include="Avalonia.X11" Version="[12.1.4]" />
    <PackageDownload Include="Avalonia.Win32" Version="[12.1.4]" />
    <Reference Include="$(NuGetPackageRoot)/avalonia.x11/12.1.4/lib/net8.0/Avalonia.X11.dll" />
    <Reference Include="$(NuGetPackageRoot)/avalonia.win32/12.1.4/lib/net8.0/*.dll" />
    <None Include="$(NuGetPackageRoot)/avalonia.x11/12.1.4/lib/net8.0/Avalonia.X11.dll" Pack="true" PackagePath="lib/net8.0/" />
    <None Include="$(NuGetPackageRoot)/avalonia.win32/12.1.4/lib/net8.0/Avalonia.Win32.dll" Pack="true" PackagePath="lib/net8.0/" />
    <None Include="../../docs/licenses/Avalonia-MIT.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
