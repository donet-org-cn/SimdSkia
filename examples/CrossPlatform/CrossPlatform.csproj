<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AvaloniaVersion Condition="'$(AvaloniaVersion)' == ''">12.1.5</AvaloniaVersion>
    <SimdSkiaPackageVersion Condition="'$(SimdSkiaPackageVersion)' == ''">0.1.1</SimdSkiaPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SimdSkia.Avalonia.Desktop/SimdSkia.Avalonia.Desktop.csproj" Condition="'$(UsePackedSimdSkia)' != 'true'" />
    <ProjectReference Include="../../src/SimdSkia.Avalonia.Gpu/SimdSkia.Avalonia.Gpu.csproj" Condition="'$(UsePackedSimdSkia)' != 'true'" />
    <PackageReference Include="SimdSkia.Avalonia.Desktop" Version="$(SimdSkiaPackageVersion)" Condition="'$(UsePackedSimdSkia)' == 'true'" />
    <PackageReference Include="SimdSkia.Avalonia.Gpu" Version="$(SimdSkiaPackageVersion)" Condition="'$(UsePackedSimdSkia)' == 'true'" />
    <PackageReference Include="Avalonia" Version="[$(AvaloniaVersion)]" GeneratePathProperty="true" ExcludeAssets="compile" />
    <Reference Include="$(PkgAvalonia)/lib/net10.0/*.dll" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[$(AvaloniaVersion)]" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../tests/AvaloniaControls/ControlScene.cs" Link="ControlScene.cs" /></ItemGroup>
  <PropertyGroup Condition="'$(UsePackedSimdSkia)' != 'true'"><SimdSkiaSourceHosts>true</SimdSkiaSourceHosts></PropertyGroup>
  <Import Project="../../src/SimdSkia.Avalonia.Desktop/buildTransitive/SimdSkia.Avalonia.Desktop.targets" Condition="'$(UsePackedSimdSkia)' != 'true'" />
</Project>
