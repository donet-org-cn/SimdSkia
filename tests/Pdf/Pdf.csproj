<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <PropertyGroup Condition="'$(NativeAotTest)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SimdSkia.Pdf/SimdSkia.Pdf.csproj" />
    <None Include="Fixtures/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
