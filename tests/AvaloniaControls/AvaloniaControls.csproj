<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><AssemblyName>SimdSkia.Avalonia.Controls.Tests</AssemblyName><DefineConstants>$(DefineConstants);MANAGED</DefineConstants><AllowUnsafeBlocks>true</AllowUnsafeBlocks><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
  <PropertyGroup><AvaloniaVersion Condition="'$(AvaloniaVersion)' == ''">12.1.5</AvaloniaVersion></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SimdSkia.Avalonia/SimdSkia.Avalonia.csproj" Condition="'$(UsePackedSimdSkia)' != 'true'" />
    <PackageReference Include="SimdSkia.Avalonia" Version="$(SimdSkiaPackageVersion)" Condition="'$(UsePackedSimdSkia)' == 'true'" />
    <PackageReference Include="Avalonia" Version="[$(AvaloniaVersion)]" GeneratePathProperty="true" ExcludeAssets="compile" />
    <Reference Include="$(PkgAvalonia)/lib/net8.0/*.dll" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[$(AvaloniaVersion)]" />
    <PackageDownload Include="Avalonia.Headless" Version="[$(AvaloniaVersion)]" />
    <Reference Include="$(NuGetPackageRoot)/avalonia.headless/$(AvaloniaVersion)/lib/net8.0/Avalonia.Headless.dll" />
  </ItemGroup>
  <ItemGroup><None Update="fixtures/*.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
