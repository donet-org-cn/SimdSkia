<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Startup.Common.props" />
  <ItemGroup>
    <PackageReference Include="Avalonia.Skia" Version="[12.1.4]" />
    <PackageReference Include="SkiaSharp" Version="[3.119.4]" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="[12.1.4]" />
    <PackageReference Include="HarfBuzzSharp" Version="[8.3.1.3]" />
  </ItemGroup>
  <Target Name="SkipReferenceNativeDebugSymbols" AfterTargets="ResolveReferences">
    <ItemGroup><ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.pdb'" /></ItemGroup>
  </Target>
</Project>
